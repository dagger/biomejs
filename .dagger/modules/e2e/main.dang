"""
End-to-end checks for the biomejs toolchain.

The fixtures are built in code rather than kept in the repository: the
repository installs biomejs in its own workspace, so a failing fixture on disk
would fail its own `dagger check`.
"""
type E2e {
  let biomeVersion: String! = "2.5.14"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  """
  The failure message of a check that should fail.
  """
  let failure(check: Check!): String! {
    { run(check); "unexpected success" } rescue {
      err: Error => err.message
    }
  }

  let changed(changes: Changeset!): [String!]! {
    changes.addedPaths + changes.modifiedPaths + changes.removedPaths
  }

  let projectFiles(ws: Workspace!, project: String!): [String!]! {
    biomejs.projects(ws).get(key: project).files(ws).keys
  }

  """
  An npm workspace root that installs Biome, holding:

  - clean: a clean project, with a `"root": false` configuration in sub/ that
    belongs to it, and a nested root project, clean/nested, that fails. clean
    passes only if it leaves clean/nested alone.
  - failing: fixable formatting in JavaScript and JSON, plus a debugger
    statement Biome has no safe fix for.
  - temp: a project in a gitignored directory.
  """
  let fixture: Workspace! {
    directory
      .withNewFile(
        "package.json",
        "{ \"private\": true, \"devDependencies\": { \"@biomejs/biome\": \"" + biomeVersion + "\" } }\n",
      )
      .withNewFile(".gitignore", "temp/\n")
      .withNewFile("clean/biome.json", "{}\n")
      .withNewFile("clean/index.js", "export const answer = 42;\n")
      .withNewFile("clean/sub/biome.jsonc", "// Belongs to the clean project.\n{ \"root\": false }\n")
      .withNewFile("clean/sub/util.js", "export const half = 21;\n")
      .withNewFile("clean/nested/biome.json", "{}\n")
      .withNewFile("clean/nested/index.js", "debugger;\n")
      .withNewFile("failing/biome.json", "{}\n")
      .withNewFile("failing/index.js", "const  a=1;\nexport { a };\n")
      .withNewFile("failing/data.json", "{\"a\":1,\n\"b\":  2}\n")
      .withNewFile("failing/debug.js", "debugger;\n")
      .withNewFile("temp/biome.json", "{}\n")
      .asWorkspace
  }

  """
  A pnpm workspace that pins Biome at its root, with a nested root project in
  packages/a. The root depends on packages/a, and packages/a on packages/b,
  through `workspace:*`, which npm cannot install. It has no
  lockfile, so --frozen-lockfile makes its install fail.
  """
  let pnpmFixture: Workspace! {
    let jsOnly = "{ \"files\": { \"includes\": [\"**/*.js\"] } }\n"
    directory
      .withNewFile(
        "package.json",
        "{ \"name\": \"fx\", \"private\": true, \"packageManager\": \"pnpm@10.25.0\", \"dependencies\": { \"a\": \"workspace:*\" }, \"devDependencies\": { \"@biomejs/biome\": \"" + biomeVersion + "\" } }\n",
      )
      .withNewFile("pnpm-workspace.yaml", "packages:\n  - \"packages/*\"\n")
      .withNewFile("biome.json", jsOnly)
      .withNewFile("index.js", "export const root = 0;\n")
      .withNewFile(
        "packages/a/package.json",
        "{ \"name\": \"a\", \"version\": \"1.0.0\", \"dependencies\": { \"b\": \"workspace:*\" } }\n",
      )
      .withNewFile("packages/a/biome.json", jsOnly)
      .withNewFile("packages/a/index.js", "export const a = 1;\n")
      .withNewFile("packages/b/package.json", "{ \"name\": \"b\", \"version\": \"1.0.0\" }\n")
      .withNewFile("packages/b/index.js", "export const b = 2;\n")
      .asWorkspace
  }

  """
  Projects are keyed by the directories of root Biome configurations at or
  below the working directory, plus the enclosing one, as workspace-root
  paths. A `"root": false` configuration folds into its root project, and
  gitignored directories are skipped.
  """
  keysCheck(ws: Workspace!): Void @check {
    let fx = fixture
    let keys = biomejs.projects(fx).keys
    assert(keys == ["clean", "clean/nested", "failing"], "projects from the root: " + keys.join(", "))

    let fromClean = biomejs.projects(fx.withWorkdir("clean")).keys
    assert(fromClean == ["clean", "clean/nested"], "projects from a project root: " + fromClean.join(", "))

    # sub holds a "root": false configuration: it belongs to clean.
    let fromSub = biomejs.projects(fx.withWorkdir("clean/sub")).keys
    assert(fromSub == ["clean"], "projects from a root: false directory: " + fromSub.join(", "))

    let fromNested = biomejs.projects(fx.withWorkdir("clean/nested")).keys
    assert(fromNested == ["clean/nested"], "projects from a nested root: " + fromNested.join(", "))

    let pnpm = biomejs.projects(pnpmFixture).keys
    assert(pnpm == [".", "packages/a"], "pnpm projects: " + pnpm.join(", "))
    let fromPackage = biomejs.projects(pnpmFixture.withWorkdir("packages/b")).keys
    assert(fromPackage == ["."], "projects from a package without a config: " + fromPackage.join(", "))

    let own = biomejs.projects(ws).keys
    assert(own == ["."], "projects in this repository: " + own.join(", "))

    # Files are keyed by workspace path. A `"root": false` configuration is a
    # file of its project; a nested root project's files are its own.
    let clean = projectFiles(fx, "clean")
    assert(
      clean == ["clean/biome.json", "clean/index.js", "clean/sub/biome.jsonc", "clean/sub/util.js"],
      "files of clean: " + clean.join(", "),
    )
    let failing = projectFiles(fx, "failing")
    assert(
      failing == ["failing/biome.json", "failing/data.json", "failing/debug.js", "failing/index.js"],
      "files of failing: " + failing.join(", "),
    )
    let ownFiles = projectFiles(ws, ".")
    assert(
      ownFiles.contains("src/index.ts") and ownFiles.contains("__dagger.entrypoint.ts") == false,
      "files of this repository: " + ownFiles.join(", "),
    )
    null
  }

  """
  A project with files Biome handles and leaves out: an excluded directory,
  excluded patterns, a nested configuration with its own files.includes and
  one that inherits the root's, a file another tool owns, an unknown file
  type, and an upper-case extension Biome handles anyway. Every file listed
  is clean; every file left out fails if Biome checks it.
  """
  let discoveryFixture: Directory! {
    directory
      .withNewFile("package.json", "{\n\t\"private\": true,\n\t\"devDependencies\": {\n\t\t\"@biomejs/biome\": \"" + biomeVersion + "\"\n\t}\n}\n")
      .withNewFile("biome.json", "{\n\t\"files\": { \"includes\": [\"**\", \"!dist\", \"!**/*.gen.ts\", \"!**/legacy/*.js\"] }\n}\n")
      .withNewFile("index.ts", "export const x = 1;\n")
      .withNewFile("Upper.JS", "export const up = 1;\n")
      .withNewFile("notes.md", "# notes\n")
      .withNewFile("data.json", "{}\n")
      .withNewFile("vendor/package-lock.json", "{}\n")
      .withNewFile("dist/out.js", "debugger;\n")
      .withNewFile("api.gen.ts", "debugger;\n")
      .withNewFile("legacy/old.js", "debugger;\n")
      .withNewFile("sub/biome.jsonc", "{ \"root\": false, \"files\": { \"includes\": [\"*.js\"] } }\n")
      .withNewFile("sub/a.js", "export const a = 1;\n")
      .withNewFile("sub/b.ts", "debugger;\n")
      .withNewFile("ext/biome.json", "{ \"root\": false, \"extends\": \"//\" }\n")
      .withNewFile("ext/y.js", "export const y = 1;\n")
      .withNewFile("ext/x.gen.ts", "debugger;\n")
  }

  let discoveredFiles: [String!]! = [
    "Upper.JS",
    "biome.json",
    "data.json",
    "ext/biome.json",
    "ext/y.js",
    "index.ts",
    "package.json",
    "sub/a.js",
  ]

  let biomeManifest(version: String!): String! {
    "{ \"private\": true, \"devDependencies\": { \"@biomejs/biome\": \"" + version + "\" } }\n"
  }

  """
  Files are those Biome checks, found from the source and the configurations
  without running Biome.
  """
  filesCheck: Void @check {
    let fx = discoveryFixture.asWorkspace
    let files = projectFiles(fx, ".")
    assert(files == discoveredFiles, "discovered files: " + files.join(", "))

    # Biome 2.6 checks Markdown and YAML too. Its version comes from an exact
    # package.json version or the lockfile; a range alone leaves it unknown,
    # and then only the types every Biome 2 handles are files.
    let typed = discoveryFixture.withNewFile("config.yaml", "a: 1\n")
    let newer = typed.withNewFile("package.json", biomeManifest("2.6.6")).asWorkspace
    let newerFiles = projectFiles(newer, ".")
    assert(
      newerFiles.contains("notes.md") and newerFiles.contains("config.yaml"),
      "files for Biome 2.6: " + newerFiles.join(", "),
    )
    let ranged = typed.withNewFile("package.json", biomeManifest("^2.5.0")).asWorkspace
    let rangedFiles = projectFiles(ranged, ".")
    assert(
      rangedFiles.contains("notes.md") == false and rangedFiles.contains("index.ts"),
      "files for an unknown Biome: " + rangedFiles.join(", "),
    )
    let locked = typed
      .withNewFile("package.json", biomeManifest("^2.5.0"))
      .withNewFile("pnpm-lock.yaml", "lockfileVersion: '9.0'\npackages:\n  '@biomejs/biome@2.6.6':\n    resolution: {integrity: sha512-x}\n")
      .asWorkspace
    let lockedFiles = projectFiles(locked, ".")
    assert(lockedFiles.contains("config.yaml"), "files for a locked Biome 2.6: " + lockedFiles.join(", "))
    null
  }

  """
  get and list build the projects at their keys; subset keeps parent order,
  rejects unknown and duplicate keys, and narrows what get accepts and what
  the collection's lint runs. The same holds for a project's files.
  """
  collectionCheck: Void @check {
    let fx = fixture
    let projects = biomejs.projects(fx)
    assert(projects.get(key: "clean/nested").path == "clean/nested", "get did not return the project at its key")
    assert(
      projects.list.{{path}}.map { p => p.path } == projects.keys,
      "list did not return one project per key, in key order",
    )

    let pair = projects.subset(keys: ["failing", "clean"])
    assert(pair.keys == ["clean", "failing"], "subset did not keep parent order: " + pair.keys.join(", "))
    let outside = { pair.get(key: "clean/nested").path } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get accepted a key outside the subset")

    let unknown = { projects.subset(keys: ["no/such/project"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")
    let duplicate = { projects.subset(keys: ["clean", "clean"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")

    # The failing projects are in the collection but outside the subset.
    projects.subset(keys: ["clean"]).lint(fx)
    projects.subset(keys: []).lint(fx)

    # The same for files: the failing files are outside the subset.
    let files = projects.get(key: "failing").files(fx)
    assert(files.get(key: "failing/index.js").path == "failing/index.js", "get did not return the file at its key")
    files.subset(keys: ["failing/biome.json"]).lint(fx)
    files.subset(keys: []).lint(fx)
    let narrowed = { files.subset(keys: ["failing/biome.json", "failing/debug.js"]).lint(fx); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      narrowed.contains("Biome failed in 1 of 2 file(s)") and narrowed.contains("- failing/debug.js: biome check failed (exit 1)"),
      "lint of a file subset did not name its failing file: " + narrowed,
    )
    null
  }

  """
  A clean project passes on its own, below a workspace-root install: Biome
  runs in the project, not in /src/src, and leaves the nested root project,
  which fails on its own, alone. The projects' lint names exactly the
  failing projects and their failing files.

  A file's check, called directly with its project's files, reports only its
  own file.
  """
  lintCheck: Void @check {
    let fx = fixture
    let projects = biomejs.projects(fx)
    projects.get(key: "clean").lint(fx)

    let nested = { projects.get(key: "clean/nested").lint(fx); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      nested.contains("- clean/nested/index.js: biome check failed (exit 1)"),
      "the nested root project passed: " + nested,
    )

    let all = { projects.lint(fx); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(all.contains("Biome failed in 2 project(s)"), "the projects' lint did not count the failing projects: " + all)
    assert(all.contains("- failing: Biome failed in 3 of 4 file(s)"), "the projects' lint did not name failing: " + all)
    assert(all.contains("failing/debug.js") and all.contains("noDebugger"), "the projects' lint did not name the failing file: " + all)
    assert(all.contains("- clean/nested: Biome failed"), "the projects' lint did not name clean/nested: " + all)
    assert(all.contains("- clean:") == false, "the projects' lint blamed the clean project: " + all)

    let files = projects.get(key: "failing").files(fx)
    let debug = failure(files.get(key: "failing/debug.js").lint(fx, selection: files))
    assert(
      debug.contains("failing/debug.js: biome check failed (exit 1)") and debug.contains("noDebugger"),
      "the failing file's check: " + debug,
    )
    assert(debug.contains("data.json") == false, "the file's check reported another file: " + debug)
    run(files.get(key: "failing/biome.json").lint(fx, selection: files))
    let outside = failure(
      files.get(key: "failing/debug.js").lint(fx, selection: files.subset(keys: ["failing/biome.json"])),
    )
    assert(outside.contains("outside the lint selection"), "a file outside its selection was linted: " + outside)
    null
  }

  """
  fix returns Biome's safe fixes, for JSON as well as JavaScript, even though
  a diagnostic without a safe fix remains, and nothing from the install. The
  changes are rooted at the caller's working directory.
  """
  fixCheck: Void @check {
    let fx = fixture
    let changes = biomejs.projects(fx).get(key: "failing").fix(fx)
    assert(
      changes.modifiedPaths == ["failing/data.json", "failing/index.js"],
      "fix changed: " + changed(changes).join(", "),
    )
    assert(
      changes.addedPaths.length == 0 and changes.removedPaths.length == 0,
      "fix added or removed files: " + changed(changes).join(", "),
    )
    let fixed = changes.after.file("failing/index.js").contents
    assert(fixed.contains("const a = 1;"), "fixed index.js: " + fixed)
    let json = changes.after.file("failing/data.json").contents
    assert(json == "{ \"a\": 1, \"b\": 2 }\n", "fixed data.json: " + json)

    let jsonOnly = biomejs.projects(fx).get(key: "failing").fix(fx, fixFilter: ["*.json"])
    assert(changed(jsonOnly) == ["failing/data.json"], "fixFilter kept: " + changed(jsonOnly).join(", "))

    let inside = fx.withWorkdir("failing")
    let local = biomejs.projects(inside).get(key: "failing").fix(inside)
    assert(
      changed(local) == ["data.json", "index.js"],
      "fix from inside the project changed: " + changed(local).join(", "),
    )

    let clean = biomejs.projects(fx).get(key: "clean").fix(fx)
    assert(clean.isEmpty, "fixing the clean project changed: " + changed(clean).join(", "))

    # The project at the install root: the install's node_modules and
    # lockfile stay out of the changes.
    let pnpm = pnpmFixture
    let root = biomejs.projects(pnpm).get(key: ".").fix(pnpm)
    assert(root.isEmpty, "fixing the install root changed: " + changed(root).join(", "))
    null
  }

  """
  Dependencies install at the workspace root with the package manager its
  package.json names, so `workspace:*` resolves, and a nested project uses
  the Biome pinned there. Install flags reach the install, an explicit
  package manager wins, and a failed install names its command.
  """
  installCheck: Void @check {
    let pnpm = pnpmFixture
    biomejs.projects(pnpm).lint(pnpm)

    # Without a lockfile, pnpm refuses a frozen install.
    let frozen = biomejs(installFlags: ["--frozen-lockfile"]).projects(pnpm)
    let one = { frozen.get(key: "packages/a").lint(pnpm); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      one.contains("install failed (pnpm install --frozen-lockfile"),
      "the install flags did not reach pnpm: " + one,
    )
    let all = { frozen.lint(pnpm); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      all.contains("- .: install failed") and all.contains("- packages/a: install failed"),
      "the projects' lint did not name each project's failed install: " + all,
    )

    let npm = {
      biomejs(packageManager: "npm").projects(pnpm).get(key: "packages/a").lint(pnpm)
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(npm.contains("install failed (npm install, exit"), "an explicit npm was not used: " + npm)
    null
  }

  """
  `file:` dependencies are installed whole, not just their package.json: the
  project extends a Biome configuration from one, which turns off the rule
  its code breaks.
  """
  localDependencyCheck: Void @check {
    let fx = directory
      .withNewFile(
        "package.json",
        "{ \"name\": \"filedep\", \"private\": true, \"packageManager\": \"pnpm@10.25.0\", \"devDependencies\": { \"@biomejs/biome\": \"" + biomeVersion + "\", \"shared-config\": \"file:./shared-config\" } }\n",
      )
      .withNewFile(
        "shared-config/package.json",
        "{ \"name\": \"shared-config\", \"version\": \"1.0.0\", \"exports\": { \"./biome\": \"./base.json\" } }\n",
      )
      .withNewFile(
        "shared-config/base.json",
        "{ \"linter\": { \"rules\": { \"suspicious\": { \"noDebugger\": \"off\" } } } }\n",
      )
      .withNewFile("app/biome.json", "{ \"extends\": [\"shared-config/biome\"] }\n")
      .withNewFile("app/index.js", "debugger;\n")
      .asWorkspace
    assert(biomejs.projects(fx).keys == ["app"], "file: dependency projects: " + biomejs.projects(fx).keys.join(", "))
    biomejs.projects(fx).get(key: "app").lint(fx)
    null
  }

  """
  A project with a package.json must install Biome itself; one without any
  package.json falls back to npx.
  """
  biomeSourceCheck: Void @check {
    let missing = directory
      .withNewFile("package.json", "{ \"private\": true }\n")
      .withNewFile("biome.json", "{}\n")
      .withNewFile("index.js", "export const x = 1;\n")
      .asWorkspace
    let notInstalled = { biomejs.projects(missing).get(key: ".").lint(missing); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      notInstalled.contains("biome is not installed: add @biomejs/biome to the devDependencies of package.json"),
      "a project without Biome did not fail clearly: " + notInstalled,
    )

    let standalone = directory
      .withNewFile("biome.json", "{}\n")
      .withNewFile("index.js", "export const x = 1;\n")
      .asWorkspace
    biomejs.projects(standalone).get(key: ".").lint(standalone)

    # npx must run Biome, not find the module's own wrapper and recurse: an
    # unformatted file fails with Biome's report.
    let unformatted = directory
      .withNewFile("biome.json", "{}\n")
      .withNewFile("index.js", "const  x=1;\nexport { x };\n")
      .asWorkspace
    let report = { biomejs.projects(unformatted).get(key: ".").lint(unformatted); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      report.contains("biome check failed (exit 1)") and report.contains("index.js format"),
      "the npx fallback did not lint: " + report,
    )
    null
  }

  # Only the unindented CHECKS header counts.
  let checkSummaryMatches(output: String!, passed: Int!, failed: Int!): Boolean! {
    let headers = output.split("\n").filter { line =>
      line.hasPrefix("CHECKS ") or line.hasPrefix("== CHECKS ==")
    }
    let expected = (if (failed > 0) { ["✘", `${failed}`, "failed"] } else { [] })
      + (if (passed > 0) { ["✔", `${passed}`, "passed"] } else { [] })
    headers.length == 1 and headers[0]!.trimPrefix("== ").trimPrefix("CHECKS").trimPrefix(" ==")
      .trimSpace.split(" ").filter { word => word != "" } == expected
  }

  """
  checkSummaryMatches reads the totals of `dagger check`.
  """
  selectedSummaryCheck: Void @check {
    assert(checkSummaryMatches("== CHECKS ==  ✘ 1 failed  ✔ 4 passed\n", 4, 1), "mixed counts were not recognized")
    assert(checkSummaryMatches("== CHECKS ==  ✔ 3 passed\n", 3, 0), "passing counts were not recognized")
    assert(checkSummaryMatches("== CHECKS ==  ✔ 13 passed\n", 3, 0) == false, "accepted a wrong count")
    assert(checkSummaryMatches("  CHECKS  ✔ 3 passed\n", 3, 0) == false, "accepted a nested header")
    null
  }

  """
  Run `dagger check` on a fixture through the engine's CLI, in its own
  session: direct calls do not apply the engine's filtered collection view.
  """
  let daggerRun(ws: Workspace!, fixture: Directory!, args: [String!]!, settings: String! = ""): Container! {
    container
      .from("alpine:3.23")
      .withEnvVariable("NO_COLOR", "1")
      .withDirectory("/source", ws.directory("/"))
      .withDirectory("/work", fixture)
      .withNewFile("/work/.git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("/work/dagger.toml", "[modules.biomejs]\nsource = \"/source\"\n" + settings)
      .withWorkdir("/work")
      .withExec(["/dev/.dagger/dagger"] + args, expect: ANY, daggerInDaggerNewSession: true)
  }

  let selectedCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    passed: Int!,
    failed: Int! = 0,
    messages: [String!]! = [],
    settings: String! = "",
  ): Void {
    let result = daggerRun(ws, fixture, ["--progress=report", "check", "--generated=false"] + args, settings)
    let output = result.stdout + result.stderr
    assert((result.exitCode == 0) == (failed == 0), "unexpected check exit status:\n" + output)
    assert(checkSummaryMatches(output, passed, failed), "unexpected Dagger check totals:\n" + output)
    messages.map { message =>
      assert(output.contains(message), "missing " + message + ":\n" + output)
    }
    null
  }

  """
  Two projects, a and b, below one install root, each with two clean files
  and a failing one.
  """
  let selectionFixture: Directory! {
    ["a", "b"].reduce(
      directory.withNewFile(
        "package.json",
        "{ \"private\": true, \"devDependencies\": { \"@biomejs/biome\": \"" + biomeVersion + "\" } }\n",
      ),
    ) { fixture, project =>
      fixture
        .withNewFile(project + "/biome.json", "{}\n")
        .withNewFile(project + "/one.js", "export const one = 1;\n")
        .withNewFile(project + "/two.js", "export const two = 2;\n")
        .withNewFile(project + "/bad.js", "debugger;\n")
    }
  }

  let fileArgs(files: [String!]!): [String!]! {
    files.map { file => "--biomejs-biome-file=" + file }
  }

  """
  Files selected in two projects pass, and the failing files left out are
  not checked: the shared command names only the selected files.
  """
  selectedFilesCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture, fileArgs(["a/one.js", "a/two.js", "b/one.js"]), passed: 3)
  }

  """
  A failing file fails only its own check.
  """
  selectedFailureCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture,
      fileArgs(["a/one.js", "a/bad.js", "b/one.js", "b/two.js"]),
      passed: 3,
      failed: 1,
      messages: ["a/bad.js: biome check failed (exit 1)", "lint/suspicious/noDebugger"],
    )
  }

  """
  A project selected whole runs `biome check` on it, with a check per file.
  """
  selectedProjectCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture,
      ["--biomejs-biome-project=b"],
      passed: 3,
      failed: 1,
      messages: ["b/bad.js: biome check failed (exit 1)"],
    )
  }

  """
  A setup failure, here a project that does not install Biome, fails every
  selected file of each project.
  """
  selectedSetupFailureCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture.withNewFile("package.json", "{ \"private\": true }\n"),
      fileArgs(["a/one.js", "b/one.js"]),
      passed: 0,
      failed: 2,
      messages: ["biome is not installed: add @biomejs/biome to the devDependencies of package.json"],
    )
  }

  """
  A project whose Biome reads another configuration than discovery does,
  alt.json through BIOME_CONFIG_PATH.
  """
  let configPathFixture(alt: String!): Directory! {
    directory
      .withNewFile(
        "package.json",
        "{ \"private\": true, \"devDependencies\": { \"@biomejs/biome\": \"" + biomeVersion + "\" } }\n",
      )
      .withNewFile("a/biome.json", "{ \"files\": { \"includes\": [\"**\", \"!extra.js\"] } }\n")
      .withNewFile("a/alt.json", alt)
      .withNewFile("a/one.js", "export const one = 1;\n")
      .withNewFile("a/two.js", "export const two = 2;\n")
      .withNewFile("a/extra.js", "debugger;\n")
  }

  let configPathSettings: String! = "[modules.biomejs.settings]\nenvironment = [\"BIOME_CONFIG_PATH=alt.json\"]\n"

  """
  Biome checks a failing file that has no check, which discovery left out:
  every check that shares the command fails.
  """
  selectedUncheckedFailureCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      configPathFixture("{}\n"),
      ["--biomejs-biome-project=a"],
      passed: 0,
      failed: 4,
      messages: ["biome check failed in files without a lint check: extra.js"],
      settings: configPathSettings,
    )
  }

  """
  Biome leaves out a selected file: its check fails as not checked rather
  than passing with nothing behind it.
  """
  selectedNotRunCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      configPathFixture("{ \"files\": { \"includes\": [\"**\", \"!two.js\"] } }\n"),
      fileArgs(["a/one.js", "a/two.js"]),
      passed: 1,
      failed: 1,
      messages: ["a/two.js: biome check did not process this file"],
      settings: configPathSettings,
    )
  }

  """
  Every discovered file of the discovery fixture is one Biome checks: the
  project passes whole, with no file left unchecked and none checked without
  a check of its own.
  """
  selectedDiscoveryCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, discoveryFixture, ["--biomejs"], passed: discoveredFiles.length)
  }

  """
  Two projects without failing files, for the checks below.
  """
  let cleanFixture: Directory! {
    selectionFixture.withoutFile("a/bad.js").withoutFile("b/bad.js")
  }

  """
  Every selected file of a project shares one biome check: six checks in two
  projects run two. A narrowed project names its selected files, sorted; a
  project with all its files selected runs whole.
  """
  selectedSharedRunCheck(ws: Workspace!): Void @check {
    # Unique content, so that no other check has cached these runs.
    let fixture = cleanFixture.withNewFile("a/marker.js", "export const sharedRunCheck = 1;\n")
    let args = fileArgs(["a/two.js", "a/marker.js", "a/one.js", "b/biome.json", "b/one.js", "b/two.js"])
    let result = daggerRun(ws, fixture, ["-vvv", "--progress=plain", "check", "--generated=false"] + args)
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "the selected checks failed:\n" + output)
    let runs = output.split("\n").filter { line =>
      line.contains("withExec /opt/dagger-biomejs/biome check") and line.contains("redirectStdout")
    }
    assert(runs.length == 2, "expected one biome check per project, got:\n" + runs.join("\n"))
    assert(
      runs.any { line => line.contains("--files-ignore-unknown=true marker.js one.js two.js (") },
      "the narrowed project did not name its selected files:\n" + runs.join("\n"),
    )
    assert(
      runs.any { line => line.contains("--files-ignore-unknown=true (") },
      "the project with every file selected did not run whole:\n" + runs.join("\n"),
    )
    let indexers = output.split("\n").filter { line => line.contains("withExec node /biome-report/index.mjs") }
    assert(indexers.length == 2, "expected one indexer per project, got:\n" + indexers.join("\n"))
    null
  }

  """
  Listing runs neither Biome nor an install, nor any container from the base
  image: with an image that does not exist and a dependency that cannot
  install, every file is still listed.
  """
  listingCheck(ws: Workspace!): Void @check {
    let fixture = cleanFixture.withNewFile(
      "package.json",
      "{ \"private\": true, \"devDependencies\": { \"@biomejs/biome\": \"" + biomeVersion + "\", \"no-such-package-dagger-biomejs\": \"0.0.0\" } }\n",
    )
    let settings = "[modules.biomejs.settings]\nbaseImageAddress = \"registry.invalid/no-such-image:0\"\n"
    let result = daggerRun(ws, fixture, ["-vvv", "--progress=plain", "check", "-l", "--all"], settings)
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "listing failed:\n" + output)
    ["a/biome.json", "a/one.js", "a/two.js", "b/biome.json", "b/one.js", "b/two.js"].map { file =>
      assert(output.contains(file), "listing missed " + file + ":\n" + output)
    }
    ["/opt/dagger-biomejs/biome", "npm install", "Container.from(address: \"registry.invalid", "/biome-report/"].map { trace =>
      assert(output.contains(trace) == false, "listing ran " + trace + ":\n" + output)
    }
    null
  }

  """
  A project whose configuration does not parse fails alone, naming the
  file; the other project passes.
  """
  selectedBrokenConfigCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      cleanFixture.withNewFile("a/biome.json", "{ \"files\": \n"),
      ["--biomejs"],
      passed: 3,
      failed: 3,
      messages: ["a/biome.json: biome check failed (exit 1)", "biome.json:"],
    )
  }

  """
  The indexer runs in its own pinned image, so a Debian base works as an
  Alpine one does.
  """
  selectedDebianBaseCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture,
      fileArgs(["a/one.js", "a/bad.js", "b/one.js"]),
      passed: 2,
      failed: 1,
      messages: ["a/bad.js: biome check failed (exit 1)"],
      settings: "[modules.biomejs.settings]\nbaseImageAddress = \"node:24-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20\"\n",
    )
  }
}
